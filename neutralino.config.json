{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "seticoneditor",
  "applicationName": "Set Icon Editor",
  "applicationIcon": "resources/icons/appIcon.png",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "filesystem.*",
    "os.*",
    "window.*"
  ],
  "modes": {
    "window": {
      "title": "Set Icon Editor",
      "width": 1280,
      "height": 800,
      "minWidth": 1024,
      "minHeight": 600,
      "icon": "resources/icons/appIcon.png",
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": true,
      "openInspectorOnStartup": false,
      "moveable": true,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    },
    "chrome": {
      "width": 1280,
      "height": 720,
      "args": "--user-agent=\"Neutralinojs chrome mode\" --log-level=3"
    }
  },
  "cli": {
    "binaryName": "setIconEditor",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
