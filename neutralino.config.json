{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "seticoneditor",
  "applicationName": "Set Icon Editor",
  "applicationIcon": "resources/icons/appIcon.png",
  "version": "1.0.0",
  "defaultMode": "chrome",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "filesystem.*",
    "os.*",
    "window.*"
  ],
  "modes": {
    "window": {
      "title": "Set Icon Editor",
      "width": 1280,
      "height": 800,
      "minWidth": 1024,
      "minHeight": 600,
      "icon": "resources/icons/appIcon.png",
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": true,
      "openInspectorOnStartup": false,
      "moveable": true,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    },
    "chrome": {
      "width": 1280,
      "height": 720,
      "args": "--user-agent=\"Neutralinojs chrome mode\" --log-level=3"
    }
  },
  "cli": {
    "binaryName": "setIconEditor",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0",
    "builder": {
      "windows": {
        "targets": [
          {
            "target": "nsis",
            "arch": ["x64"],
            "icon": "./installerassets/windows/nsis/app.ico",
            "sidebarImage": "./installerassets/windows/nsis/sidebar.bmp",
            "headerImage": "./installerassets/windows/nsis/header.bmp",
            "license": "./installerassets/LICENSE.txt",
            "output": "./dist/windows"
          }
        ]
      },
      "linux": {
        "targets": [
          {
            "target": "deb",
            "arch": ["x64", "arm64", "armhf"],
            "icon": "./installerassets/linux/deb/app.png",
            "category": "Graphics",
            "output": "./dist/linux",
            "maintainer": "mator",
            "description": "SVG set-icon editor companion for Card Magician"
          },
          {
            "target": "appimage",
            "arch": ["x64", "arm64"],
            "icon": "./installerassets/linux/appimage/app.png",
            "license": "./installerassets/LICENSE.txt",
            "output": "./dist/linux",
            "maintainer": "mator",
            "description": "SVG set-icon editor companion for Card Magician"
          }
        ]
      },
      "mac": {
        "targets": [
          {
            "target": "dmg",
            "arch": ["x64", "arm64", "universal"],
            "icon": "./installerassets/mac/dmg/app.icns",
            "background": "./installerassets/mac/dmg/dmg-background.png",
            "iconSize": 80,
            "window": { "width": 660, "height": 400 },
            "appPosition": { "x": 180, "y": 170 },
            "applicationsSymlinkPosition": { "x": 480, "y": 170 },
            "output": "./dist/mac"
          }
        ]
      }
    }
  }
}
